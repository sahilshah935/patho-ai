# ==============================================================================
# PathO Clinical AI Platform - Configuration & LLM Providers
# ==============================================================================
# Option 1: Google Gemini (Free key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: Groq Cloud (Free key at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: OpenAI / Compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 4: Local Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Provider Override (auto, gemini, groq, openai, ollama, offline)
LLM_PROVIDER=auto
